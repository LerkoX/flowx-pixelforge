{
  "name": "flux-vae-encode",
  "displayName": "FLUX VAE 编码",
  "description": "FLUX VAE 编码（对标 ComfyUI VAE Encode）：图像 → 未 pack 归一化 LATENT，供 flux-sampler 以 denoise<1 做 img2img / hires-fix 两阶段。自包含节点：server_op.py 运行时自注册",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "flux",
    "gguf",
    "inference"
  ],
  "icon": "📥",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.9",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "vae",
      "type": "string",
      "description": "FLUX VAE 组件引用",
      "required": true,
      "source": {
        "nodeRef": "flux-vae-load",
        "output": "vae",
        "description": "由 FLUX VAE 加载节点提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "待编码图像对象 ID",
      "required": true,
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "由加载图像（或上级解码/重绘）节点提供"
      }
    },
    {
      "name": "job_timeout",
      "type": "integer",
      "description": "编码超时（秒）",
      "required": false,
      "default": 1800
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "VAE": "{{ Param.vae }}",
    "IMAGE": "{{ Param.image }}",
    "JOB_TIMEOUT": "{{ Param.job_timeout }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "latent",
      "type": "string",
      "description": "FLUX LATENT 束引用（接 flux-sampler 的 latent，配 denoise<1）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 200,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 1900,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "local",
    "bundled": true
  }
}
