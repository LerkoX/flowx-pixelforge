{
  "name": "image-curves",
  "displayName": "曲线映射",
  "description": "曲线映射（对标 ComfyUI Image Curves / WAS 曲线）：控制点串 'x,y;x,y;...' 生成 256 项 LUT（分段线性插值），可只作用于单通道或全通道。画布提供曲线编辑器。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "filter"
  ],
  "icon": "📈",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py",
    "image_filters.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "required": true,
      "description": "输入图像对象 ID"
    },
    {
      "name": "channel",
      "type": "string",
      "default": "all",
      "description": "作用通道：all（RGB 全通道）/ red / green / blue"
    },
    {
      "name": "points",
      "type": "string",
      "default": "0,0;255,255",
      "description": "曲线控制点，分号分隔、逗号分坐标（如 0,0;128,180;255,255）；x 为输入亮度 0~255，y 为输出亮度 0~255，按 x 升序分段线性"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "CHANNEL": "{{ Param.channel }}",
    "IMAGE": "{{ Param.image }}",
    "POINTS": "{{ Param.points }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.15.1"
}
