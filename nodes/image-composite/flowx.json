{
  "name": "image-composite",
  "displayName": "图像合成",
  "description": "前景贴到底图（对标 ComfyUI Image Composite Masked）：可选蒙版控制贴合区域（蒙版尺寸不符前景时自动缩放），缺省蒙版则整张前景贴到指定偏移；越界部分自动裁掉",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image"
  ],
  "icon": "🧩",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "background",
      "type": "string",
      "description": "底图图像对象 ID",
      "required": true
    },
    {
      "name": "foreground",
      "type": "string",
      "description": "前景图像对象 ID",
      "required": true
    },
    {
      "name": "mask",
      "type": "string",
      "description": "蒙版对象 ID（可选，灰度图像；空则不使用）",
      "required": false,
      "default": ""
    },
    {
      "name": "x",
      "type": "integer",
      "description": "前景左上角 X 偏移（像素）",
      "required": false,
      "default": 0
    },
    {
      "name": "y",
      "type": "integer",
      "description": "前景左上角 Y 偏移（像素）",
      "required": false,
      "default": 0
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "BACKGROUND": "{{ Param.background }}",
    "FOREGROUND": "{{ Param.foreground }}",
    "MASK": "{{ Param.mask }}",
    "X": "{{ Param.x }}",
    "Y": "{{ Param.y }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    },
    {
      "name": "thumb_b64",
      "type": "string",
      "description": "结果缩略图 data URL（JPEG，画布 widget 预览用）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 320,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local"
    ],
    "preferredType": "local"
  }
}
