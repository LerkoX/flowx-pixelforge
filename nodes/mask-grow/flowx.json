{
  "name": "mask-grow",
  "displayName": "蒙版扩缩",
  "description": "蒙版扩张/收缩（对标 ComfyUI Grow Mask）：radius 正扩负缩（像素半径），0 原样返回",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "mask"
  ],
  "icon": "🔵",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "mask",
      "type": "string",
      "description": "推理服务端的蒙版对象 ID（灰度图像）",
      "required": true
    },
    {
      "name": "radius",
      "type": "integer",
      "description": "扩张像素半径（正值扩张白色区域，负值收缩，0 不处理）",
      "required": false,
      "default": 0
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "MASK": "{{ Param.mask }}",
    "RADIUS": "{{ Param.radius }}"
  },
  "outputs": [
    {
      "name": "mask",
      "type": "string",
      "description": "处理后蒙版在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    },
    {
      "name": "thumb_b64",
      "type": "string",
      "description": "结果缩略图 data URL（JPEG，画布 widget 预览用）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 320,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.2"
}
