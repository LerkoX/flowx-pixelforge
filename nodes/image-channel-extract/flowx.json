{
  "name": "image-channel-extract",
  "displayName": "通道分离",
  "description": "通道分离（对标 ComfyUI Image Channel Extract）：导出单通道为灰度图。luminance 走 L 转换；red/green/blue 取 RGB 单通道；alpha 取透明度（无 alpha 时为全白）。结果可直接当蒙版喂 mask-* / latent-set-noise-mask 节点。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "filter"
  ],
  "icon": "🧬",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py",
    "image_filters.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "required": true,
      "description": "输入图像对象 ID"
    },
    {
      "name": "channel",
      "type": "string",
      "default": "luminance",
      "description": "导出通道：luminance（亮度灰度）/ red / green / blue / alpha（透明度，原图无 alpha 时输出全白 255）"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "CHANNEL": "{{ Param.channel }}",
    "IMAGE": "{{ Param.image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.7"
}
