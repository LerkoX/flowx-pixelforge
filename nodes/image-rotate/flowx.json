{
  "name": "image-rotate",
  "displayName": "旋转图像",
  "description": "任意角度旋转图像（对标 ComfyUI Image Rotate），纯客户端 PIL 处理：下载图像 → 旋转 → 传回推理服务，输出新图像对象 ID",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image"
  ],
  "icon": "🔄",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "推理服务端的图像对象 ID",
      "required": true
    },
    {
      "name": "angle",
      "type": "float",
      "description": "旋转角度（度，逆时针为正）",
      "required": false,
      "default": 0
    },
    {
      "name": "expand",
      "type": "boolean",
      "description": "true 时扩大画布容纳旋转后全图，false 保持原尺寸裁剪",
      "required": false,
      "default": true
    },
    {
      "name": "resample",
      "type": "string",
      "description": "重采样算法：nearest / bilinear / bicubic",
      "required": false,
      "default": "bicubic"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "IMAGE": "{{ Param.image }}",
    "ANGLE": "{{ Param.angle }}",
    "EXPAND": "{{ Param.expand }}",
    "RESAMPLE": "{{ Param.resample }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    },
    {
      "name": "thumb_b64",
      "type": "string",
      "description": "结果缩略图 data URL（JPEG，画布 widget 预览用）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 320,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.3"
}
