{
  "name": "upscale-model-apply",
  "displayName": "模型放大",
  "description": "UPSCALE_MODEL + 图像 → 放大图（倍数为模型自带 scale）；tile=0 整图（默认，显存够时最快），>0 分块（overlap 16px 消接缝，大分辨率防爆显存）。服务端插件 upscale_ops.py 为唯一实现来源",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "upscale"
  ],
  "icon": "🔍",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py",
    "server_op.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址：模型列表查询、预览帧/重放/中断中转都由 Studio 发请求，用的是 Studio 的网络视角。docker 节点的 service_url 只能填容器内网地址（如 http://172.17.0.1:8100），Studio（手机/外网侧）取不到——此时把本参数绑成 Studio 可达地址（通常绑 {{ Param.service_url }} 公网隧道），否则画布上没有模型下拉数据、也看不到实时预览。留空则同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "upscale_model",
      "type": "string",
      "description": "UPSCALE_MODEL 对象 ID",
      "required": true,
      "source": {
        "nodeRef": "upscale-model-load",
        "output": "upscale_model",
        "description": "由放大模型加载节点输出提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "待放大图对象 ID",
      "required": true,
      "source": {
        "nodeRef": "vae-decode",
        "output": "image",
        "description": "由 VAE 解码等节点的 image 输出提供"
      }
    },
    {
      "name": "tile",
      "type": "integer",
      "description": "分块大小（0=整图；>0 分块+16px overlap）",
      "required": false,
      "default": 0
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "UPSCALE_MODEL": "{{ Param.upscale_model }}",
    "IMAGE": "{{ Param.image }}",
    "TILE": "{{ Param.tile }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "放大后图像对象 ID（尺寸 = 输入 × 模型 scale）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.8.0",
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 700,
    "collapsed": false,
    "apiVersion": 1
  }
}
