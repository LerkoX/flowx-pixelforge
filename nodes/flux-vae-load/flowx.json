{
  "name": "flux-vae-load",
  "displayName": "FLUX VAE 加载",
  "description": "FLUX VAE 加载（对标 ComfyUI Load VAE）：装载 FLUX 专用 AutoencoderKL（FLUX_DIR/vae，fp16），输出 VAE 组件引用供 VAE 编解码/局部重绘节点消费。自包含节点：server_op.py 运行时自注册",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "flux",
    "gguf",
    "inference"
  ],
  "icon": "🌈",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.7.0",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "name",
      "type": "string",
      "description": "VAE 目录名（/models/flux 下）",
      "required": false,
      "default": "vae"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "NAME": "{{ Param.name }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "vae",
      "type": "string",
      "description": "FLUX VAE 组件引用（接 flux-vae-decode / flux-vae-encode / flux-detail-refine 的 vae）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 200,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "local",
    "bundled": true
  }
}
