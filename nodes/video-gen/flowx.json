{
  "name": "video-gen",
  "displayName": "视频生成",
  "description": "文/图生视频（Wan TI2V 系，经推理服务异步任务体系 POST /jobs 执行）：消费模型引用与提示词，可选接首帧图像，输出 VIDEO 对象 ID；运行中画布显示采样进度卡片，任务可被 /interrupt 取消",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": [
    "video",
    "wan",
    "inference"
  ],
  "icon": "🎬",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.1",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "model_ref",
      "type": "string",
      "description": "视频模型引用 ID（checkpoint-loader 加载 Wan TI2V diffusers 目录）",
      "required": true,
      "source": {
        "nodeRef": "checkpoint-loader",
        "output": "model_ref",
        "description": "由 Checkpoint 加载节点的 model_ref 输出提供"
      }
    },
    {
      "name": "prompt",
      "type": "string",
      "description": "正向提示词（视频内容/运动描述）",
      "required": true
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "description": "反向提示词",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "description": "首帧 IMAGE 对象 ID（可选，图生视频）；留空为纯文生视频",
      "required": false,
      "default": "",
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "由图像加载节点输出提供（可选）"
      }
    },
    {
      "name": "width",
      "type": "integer",
      "description": "宽度（Wan2.2-TI2V-5B 推荐 832）",
      "required": false,
      "default": 832
    },
    {
      "name": "height",
      "type": "integer",
      "description": "高度（Wan2.2-TI2V-5B 推荐 480）",
      "required": false,
      "default": 480
    },
    {
      "name": "num_frames",
      "type": "integer",
      "description": "帧数（121 帧 @24fps ≈ 5 秒）",
      "required": false,
      "default": 121
    },
    {
      "name": "fps",
      "type": "integer",
      "description": "帧率（写入 mp4 元数据；Wan 原生 24）",
      "required": false,
      "default": 24
    },
    {
      "name": "steps",
      "type": "integer",
      "description": "采样步数",
      "required": false,
      "default": 50
    },
    {
      "name": "cfg",
      "type": "float",
      "description": "引导强度",
      "required": false,
      "default": 5.0
    },
    {
      "name": "seed",
      "type": "integer",
      "description": "随机种子，-1 = 每次随机",
      "required": false,
      "default": -1
    },
    {
      "name": "preview_every",
      "type": "integer",
      "description": "每 N 步录一次进度卡片帧（0=关闭）。帧留在推理服务 GET /preview/{job_id}，由 Studio 中转拉取给画布",
      "required": false,
      "default": 5
    },
    {
      "name": "poll_interval",
      "type": "integer",
      "description": "任务状态轮询间隔（秒）",
      "required": false,
      "default": 5
    },
    {
      "name": "job_timeout",
      "type": "integer",
      "description": "任务超时（秒），超时自动 /interrupt 取消服务端任务",
      "required": false,
      "default": 7200
    },
    {
      "name": "decode_chunk_size",
      "type": "integer",
      "description": "VAE 分块解码帧数（0=管道默认；显存紧张时设 4~8，SVD 有效）",
      "required": false,
      "default": 0
    },
    {
      "name": "output_mode",
      "type": "string",
      "description": "输出模式：pil=采样+解码一体输出 VIDEO(默认)；latent=只采样输出 3D LATENT，交下游 vae.decode_video 节点解码(decode 精度/分块可调)",
      "required": false,
      "default": "pil"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "MODEL_REF": "{{ Param.model_ref }}",
    "PROMPT": "{{ Param.prompt }}",
    "NEGATIVE_PROMPT": "{{ Param.negative_prompt }}",
    "IMAGE": "{{ Param.image }}",
    "WIDTH": "{{ Param.width }}",
    "HEIGHT": "{{ Param.height }}",
    "NUM_FRAMES": "{{ Param.num_frames }}",
    "FPS": "{{ Param.fps }}",
    "STEPS": "{{ Param.steps }}",
    "CFG": "{{ Param.cfg }}",
    "SEED": "{{ Param.seed }}",
    "DECODE_CHUNK_SIZE": "{{ Param.decode_chunk_size }}",
    "PREVIEW_EVERY": "{{ Param.preview_every }}",
    "POLL_INTERVAL": "{{ Param.poll_interval }}",
    "JOB_TIMEOUT": "{{ Param.job_timeout }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "OUTPUT_MODE": "{{ Param.output_mode }}"
  },
  "outputs": [
    {
      "name": "video",
      "type": "string",
      "description": "推理服务端的 VIDEO 对象 ID（供 save-video 下载）"
    },
    {
      "name": "seed",
      "type": "integer",
      "description": "实际使用的随机种子"
    },
    {
      "name": "latent",
      "type": "string",
      "description": "3D LATENT 对象 ID(仅 output_mode=latent 时产出，供 vae.decode_video 接力)"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 480,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 7500,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  }
}
