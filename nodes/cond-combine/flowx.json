{
  "name": "cond-combine",
  "displayName": "Conditioning 拼接",
  "description": "两段 conditioning 沿序列维拼接（对标 ComfyUI ConditioningCombine），两段提示词同时生效，可突破 77 token 截断；多区域构图 = set_area 产物经本算子串联。暂不支持 SD3 dict 形式 COND",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "conditioning"
  ],
  "icon": "🔗",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "cond_a",
      "type": "string",
      "description": "COND 对象 ID（第一段）",
      "required": true,
      "source": {
        "nodeRef": "clip-text-encode",
        "output": "conditioning",
        "description": "由 clip-text-encode 的 conditioning 输出提供"
      }
    },
    {
      "name": "cond_b",
      "type": "string",
      "description": "COND 对象 ID（第二段）",
      "required": true,
      "source": {
        "nodeRef": "clip-text-encode",
        "output": "conditioning",
        "description": "由 clip-text-encode 的 conditioning 输出提供"
      }
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "COND_A": "{{ Param.cond_a }}",
    "COND_B": "{{ Param.cond_b }}"
  },
  "outputs": [
    {
      "name": "cond",
      "type": "string",
      "description": "拼接后 COND 对象 ID，供采样节点 positive/negative 输入"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.3",
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 700,
    "collapsed": false,
    "apiVersion": 1
  }
}
