{
  "name": "image-channel-merge",
  "displayName": "通道合并",
  "description": "通道合并（对标 ComfyUI Image Channel Merge）：三路灰度图按 R/G/B 合并为 RGB，可选 alpha 图合成 RGBA。尺寸以 R 路为准，其余路自动缩放对齐。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "filter"
  ],
  "icon": "🧪",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py",
    "image_filters.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "r_image",
      "type": "string",
      "required": true,
      "description": "R 通道图像对象 ID（灰度图；同时决定输出尺寸）"
    },
    {
      "name": "g_image",
      "type": "string",
      "required": true,
      "description": "G 通道图像对象 ID（灰度图，尺寸不符自动缩放）"
    },
    {
      "name": "b_image",
      "type": "string",
      "required": true,
      "description": "B 通道图像对象 ID（灰度图，尺寸不符自动缩放）"
    },
    {
      "name": "alpha_image",
      "type": "string",
      "required": false,
      "default": "",
      "description": "可选 alpha 通道图像对象 ID（灰度高值=不透明）；空则输出 RGB"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "ALPHA_IMAGE": "{{ Param.alpha_image }}",
    "B_IMAGE": "{{ Param.b_image }}",
    "G_IMAGE": "{{ Param.g_image }}",
    "R_IMAGE": "{{ Param.r_image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.5"
}
