{
  "name": "embedding-load",
  "displayName": "Embedding 加载",
  "description": "Textual Inversion 加载：把 embeddings 目录下的 embedding（逗号分隔，如 badhandv4,EasyNegative）载进 CLIP 文本编码器；之后正/反提示词里直接写该词生效（常用于负面压制缺陷）。幂等，已加载自动跳过",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "embedding"
  ],
  "icon": "📚",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "clip",
      "type": "string",
      "description": "CLIP 对象 ID",
      "required": true,
      "source": {
        "nodeRef": "checkpoint-loader",
        "output": "clip_ref",
        "description": "由 checkpoint-loader 的 clip_ref 输出提供"
      }
    },
    {
      "name": "names",
      "type": "string",
      "description": "embedding 名（逗号分隔，如 badhandv4,EasyNegative）",
      "required": false,
      "default": ""
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "CLIP": "{{ Param.clip }}",
    "NAMES": "{{ Param.names }}"
  },
  "outputs": [
    {
      "name": "clip",
      "type": "string",
      "description": "加载 embedding 后的 CLIP 对象 ID，供 clip-text-encode 的 clip_ref"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.3",
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 700,
    "collapsed": false,
    "apiVersion": 1
  }
}
