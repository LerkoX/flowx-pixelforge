{
  "name": "cond-set-area",
  "displayName": "Conditioning 设区域",
  "description": "把整图 cond 标记为只在指定区域生效（对标 ComfyUI ConditioningSetArea）：x/y/width/height 为图像像素，strength 为该段权重。多区域构图 = 多个 set_area 经 cond-combine 拼接（重叠区域效果叠加）。暂不与 controlnet 组合",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "conditioning"
  ],
  "icon": "📐",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "cond",
      "type": "string",
      "description": "COND 对象 ID",
      "required": true,
      "source": {
        "nodeRef": "clip-text-encode",
        "output": "conditioning",
        "description": "由 clip-text-encode 的 conditioning 输出提供"
      }
    },
    {
      "name": "x",
      "type": "integer",
      "description": "区域左上角 x（图像像素）",
      "required": false,
      "default": 0
    },
    {
      "name": "y",
      "type": "integer",
      "description": "区域左上角 y（图像像素）",
      "required": false,
      "default": 0
    },
    {
      "name": "width",
      "type": "integer",
      "description": "区域宽（图像像素，>0）",
      "required": false,
      "default": 512
    },
    {
      "name": "height",
      "type": "integer",
      "description": "区域高（图像像素，>0）",
      "required": false,
      "default": 512
    },
    {
      "name": "strength",
      "type": "float",
      "description": "该段权重（>0，默认 1.0）",
      "required": false,
      "default": 1.0
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "COND": "{{ Param.cond }}",
    "X": "{{ Param.x }}",
    "Y": "{{ Param.y }}",
    "WIDTH": "{{ Param.width }}",
    "HEIGHT": "{{ Param.height }}",
    "STRENGTH": "{{ Param.strength }}"
  },
  "outputs": [
    {
      "name": "cond",
      "type": "string",
      "description": "带区域标记的 COND 段列表，经 cond-combine 串联后送采样"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.1",
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 700,
    "collapsed": false,
    "apiVersion": 1
  }
}
