{
  "name": "matting-refine",
  "displayName": "蒙版精修（alpha）",
  "description": "抠图 alpha 精修（对标 ComfyUI Mask 系 + 抠图后处理）：阈值/伽马/对比度/羽化/扩缩/去小杂点/反相，一次算子完成。纯节点侧 PIL，不占显存。与 mask-grow/mask-feather/mask-invert 的分工：单一操作请用那三个，串联调参用本节点",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "mask",
    "matting"
  ],
  "icon": "🧽",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧/重放中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "mask",
      "type": "string",
      "required": true,
      "description": "待精修的蒙版对象 ID（灰度）",
      "source": {
        "nodeRef": "matting-birefnet",
        "output": "mask",
        "description": "由 matting-birefnet 的 mask 输出提供"
      }
    },
    {
      "name": "threshold",
      "type": "integer",
      "default": 0,
      "description": "二值化阈值 0~255（0 = 不二值化，保留灰阶羽化）"
    },
    {
      "name": "gamma",
      "type": "float",
      "default": 1.0,
      "description": "alpha 伽马（>1 前景更饱满，<1 更克制）"
    },
    {
      "name": "contrast",
      "type": "float",
      "default": 1.0,
      "description": "alpha 对比度（>1 边缘更硬）"
    },
    {
      "name": "feather",
      "type": "integer",
      "default": 0,
      "description": "羽化半径（像素，0 = 不羽化）"
    },
    {
      "name": "grow",
      "type": "integer",
      "default": 0,
      "description": "扩张/收缩（像素，正=扩，负=缩）"
    },
    {
      "name": "despeckle",
      "type": "integer",
      "default": 0,
      "description": "去小杂点：形态学开运算核尺寸（奇数，0=不关；3/5/7 抹掉尺度 <k/2 的孤立点）"
    },
    {
      "name": "invert",
      "type": "boolean",
      "default": false,
      "description": "蒙版反相"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "MASK": "{{ Param.mask }}",
    "THRESHOLD": "{{ Param.threshold }}",
    "GAMMA": "{{ Param.gamma }}",
    "CONTRAST": "{{ Param.contrast }}",
    "FEATHER": "{{ Param.feather }}",
    "GROW": "{{ Param.grow }}",
    "INVERT": "{{ Param.invert }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "DESPECKLE": "{{ Param.despeckle }}"
  },
  "outputs": [
    {
      "name": "mask",
      "type": "string",
      "description": "精修后蒙版对象 ID（灰度）"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 336,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.18.0"
}
