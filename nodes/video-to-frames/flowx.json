{
  "name": "video-to-frames",
  "displayName": "视频转帧序列",
  "description": "VIDEO 对象 → 帧序列（IMAGE 批量对象，按 index 取单帧：GET /images/{id}?index=n），输出 frames 对象 ID + fps + 帧数，供 frames-to-video（帧回视频）与需要逐帧观察/抽帧看图的场景使用。抽帧口径与 load-video 一致（start/end/stride/max_frames）。画布结果预览显示第 0 帧。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "video",
    "inference",
    "io"
  ],
  "icon": "✂️",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py",
    "server_op.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（结果帧预览中转用）；docker 节点跑在远端宿主时必须单独绑，留空则同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "video",
      "type": "string",
      "description": "推理服务端的 VIDEO 对象 ID",
      "required": true,
      "source": {
        "nodeRef": "load-video",
        "output": "video",
        "description": "由加载视频 / video-gen / video-repaint / video-v2v 的输出提供"
      }
    },
    {
      "name": "start",
      "type": "integer",
      "description": "起始帧序号（含，默认 0）",
      "required": false,
      "default": 0
    },
    {
      "name": "end",
      "type": "integer",
      "description": "结束帧序号（不含，0=到尾）",
      "required": false,
      "default": 0
    },
    {
      "name": "stride",
      "type": "integer",
      "description": "抽帧步长（每隔 N 帧取一帧，默认 1=全取）",
      "required": false,
      "default": 1
    },
    {
      "name": "max_frames",
      "type": "integer",
      "description": "最多取多少帧（0=不限）",
      "required": false,
      "default": 0
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    },
    {
      "name": "job_timeout",
      "type": "integer",
      "description": "服务端任务超时（秒）",
      "required": false,
      "default": 1800
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "VIDEO": "{{ Param.video }}",
    "START": "{{ Param.start }}",
    "END": "{{ Param.end }}",
    "STRIDE": "{{ Param.stride }}",
    "MAX_FRAMES": "{{ Param.max_frames }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "JOB_TIMEOUT": "{{ Param.job_timeout }}"
  },
  "outputs": [
    {
      "name": "frames",
      "type": "string",
      "description": "帧序列 IMAGE 批量对象 ID（单对象多帧，index 取用）"
    },
    {
      "name": "fps",
      "type": "integer",
      "description": "源视频有效帧率"
    },
    {
      "name": "count",
      "type": "integer",
      "description": "帧数"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 330,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 1800,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.7"
}
