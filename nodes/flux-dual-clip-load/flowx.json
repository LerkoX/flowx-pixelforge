{
  "name": "flux-dual-clip-load",
  "displayName": "FLUX DualCLIP 加载",
  "description": "FLUX 双文本编码器加载（对标 ComfyUI DualCLIPLoader）：CLIP-L(bf16)+双 tokenizer 立即装载，T5-XXL(GGUF) 编码相位才装载上卡（内存错峰）。输出 CLIP 组件束引用。自包含节点：server_op.py 运行时自注册",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "flux",
    "gguf",
    "inference"
  ],
  "icon": "📎",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.7.1",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "t5",
      "type": "string",
      "description": "T5-XXL GGUF 文件名（/models/flux 下）",
      "required": false,
      "default": "t5xxl-Q4_K_S.gguf"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "T5": "{{ Param.t5 }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "clip",
      "type": "string",
      "description": "FLUX CLIP 组件束引用（接 flux-clip-encode 的 clip）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 200,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "local",
    "bundled": true
  }
}
