{
  "name": "flux-unet-load",
  "displayName": "FLUX UNET 加载",
  "description": "FLUX 扩散模型（transformer）加载（对标 ComfyUI UNETLoader）：GGUF Q4_K_S 单独装载（fp16 compute），输出 MODEL 组件引用供采样/局部重绘节点消费。自包含节点：server_op.py 运行时自注册（需服务端配置 INFERENCE_TOKEN）",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "flux",
    "gguf",
    "inference"
  ],
  "icon": "🧱",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.9",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "transformer",
      "type": "string",
      "description": "transformer GGUF 文件名（/models/flux 下，city96 Q4_K_S 量化）",
      "required": false,
      "default": "flux1-schnell-Q4_K_S.gguf"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "TRANSFORMER": "{{ Param.transformer }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "model",
      "type": "string",
      "description": "FLUX MODEL 组件引用（接 flux-sampler 的 model / flux-detail-refine 的 model）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 200,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 1800,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "local",
    "bundled": true
  }
}
