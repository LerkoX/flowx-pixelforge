{
  "name": "grounding-detect",
  "displayName": "文本提示检测",
  "description": "GroundingDINO 开放词汇检测：文本提示（多类用 ' . ' 分隔）→ 检测框/标签/置信度。可选把检测框再喂 SAM（sam_model 非空）得到**像素级蒙版** ⇒ 一条链完成「文本 → 精确蒙版」。服务端插件 seg.py 为唯一实现来源",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "segment",
    "grounding"
  ],
  "icon": "🔤",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "executor_base.py",
    "server_op.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "required": true,
      "description": "推理服务地址（docker 执行器用容器内网 http://172.17.0.1:8100；local 执行器用手机可达地址，如 http隧道 http://xxx.r7.cpolar.cn）",
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧/重放中转用），留空同 service_url"
    },
    {
      "name": "image",
      "type": "string",
      "description": "待检测的图像对象 ID",
      "required": true,
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "由 load-image / vae-decode 的 image 输出提供"
      }
    },
    {
      "name": "model",
      "type": "string",
      "description": "GroundingDINO 模型键",
      "default": "gd:tiny"
    },
    {
      "name": "prompt",
      "type": "string",
      "description": "文本提示：多个类用 ' . ' 分隔，如 'person . red dress'（内部自动小写并补尾点，实测裸词也能命中）",
      "default": "person"
    },
    {
      "name": "box_threshold",
      "type": "float",
      "description": "框置信度门限",
      "default": 0.35
    },
    {
      "name": "text_threshold",
      "type": "float",
      "description": "文本匹配门限",
      "default": 0.25
    },
    {
      "name": "max_boxes",
      "type": "integer",
      "description": "最多输出框数",
      "default": 10
    },
    {
      "name": "sam_model",
      "type": "string",
      "description": "非空则把框再喂 SAM 出像素级蒙版（如 sam:vit_l）",
      "default": ""
    },
    {
      "name": "overlay",
      "type": "float",
      "description": "蒙版叠加透明度",
      "default": 0.5
    },
    {
      "name": "service_token",
      "type": "string",
      "required": false,
      "default": "",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空"
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "IMAGE": "{{ Param.image }}",
    "MODEL": "{{ Param.model }}",
    "PROMPT": "{{ Param.prompt }}",
    "BOX_THRESHOLD": "{{ Param.box_threshold }}",
    "TEXT_THRESHOLD": "{{ Param.text_threshold }}",
    "MAX_BOXES": "{{ Param.max_boxes }}",
    "SAM_MODEL": "{{ Param.sam_model }}",
    "OVERLAY": "{{ Param.overlay }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "annotated",
      "type": "string",
      "description": "标注图对象 ID（框+标签+置信度）"
    },
    {
      "name": "boxes",
      "type": "string",
      "description": "框坐标 JSON"
    },
    {
      "name": "labels",
      "type": "string",
      "description": "标签 JSON"
    },
    {
      "name": "scores",
      "type": "string",
      "description": "置信度 JSON"
    },
    {
      "name": "count",
      "type": "integer",
      "description": "命中数"
    },
    {
      "name": "mask",
      "type": "string",
      "description": "蒙版对象 ID（有 sam_model 则像素级，否则框并集）"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "宽度"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "高度"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 380,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 1800,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.7"
}
