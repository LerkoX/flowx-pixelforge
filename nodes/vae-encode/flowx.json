{
  "name": "vae-encode",
  "displayName": "VAE 编码",
  "description": "将图像编码为 latent（对应 ComfyUI VAE Encode），供图生图链路使用：输出接 KSampler 的 latent 输入并将 denoise 调低（如 0.6）",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference"
  ],
  "icon": "🧊",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.3.0",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "vae_ref",
      "type": "string",
      "description": "VAE 引用 ID",
      "required": true,
      "source": {
        "nodeRef": "checkpoint-loader",
        "output": "vae_ref",
        "description": "由 Checkpoint 加载节点的 vae_ref 输出提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "待编码的图像对象 ID",
      "required": true,
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "由加载图像节点输出提供"
      }
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "VAE_REF": "{{ Param.vae_ref }}",
    "IMAGE": "{{ Param.image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "latent",
      "type": "string",
      "description": "编码后 latent 在推理服务的对象 ID（接 KSampler 的 latent 输入）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 240,
    "height": 110,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  }
}
