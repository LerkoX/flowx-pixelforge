{
  "name": "vae-encode",
  "displayName": "VAE 编码",
  "description": "将图像编码为 latent（对应 ComfyUI VAE Encode），供图生图链路使用：输出接 KSampler 的 latent 输入并将 denoise 调低（如 0.6）。v1.2.0：同步 /op 改任务式（submit_job+轮询+job 标记）；job_timeout=1800s 覆盖队列等待（exec 743 事故根治）。",
  "version": "1.2.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference"
  ],
  "icon": "🧊",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.3",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Studio 宿主机侧（画布/取消兜底）可达的服务地址；docker 节点跑在远端宿主时 service_url 是容器内地址，必须另绑本参数（留空则同 service_url）"
    },
    {
      "name": "vae_ref",
      "type": "string",
      "description": "VAE 引用 ID",
      "required": true,
      "source": {
        "nodeRef": "checkpoint-loader",
        "output": "vae_ref",
        "description": "由 Checkpoint 加载节点的 vae_ref 输出提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "待编码的图像对象 ID",
      "required": true,
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "由加载图像节点输出提供"
      }
    },
    {
      "name": "job_timeout",
      "type": "integer",
      "required": false,
      "default": 1800,
      "description": "任务超时（秒）；排队+计算总预算（要盖住最长任务的排队时间）"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    },
    {
      "name": "poll_interval",
      "type": "integer",
      "required": false,
      "default": 5,
      "description": "任务轮询间隔（秒）"
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "VAE_REF": "{{ Param.vae_ref }}",
    "IMAGE": "{{ Param.image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}"
  },
  "outputs": [
    {
      "name": "latent",
      "type": "string",
      "description": "编码后 latent 在推理服务的对象 ID（接 KSampler 的 latent 输入）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 240,
    "height": 110,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 2100,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  }
}
