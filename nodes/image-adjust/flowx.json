{
  "name": "image-adjust",
  "displayName": "亮度对比度伽马锐度",
  "description": "传统图像调整（对标 ComfyUI Image Adjust / WAS 基础调节）：亮度 / 对比度 / 伽马 / 锐度，各参数 1.0 = 不变（gamma>1 变亮）。纯节点侧 PIL，不占显存。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "filter"
  ],
  "icon": "🎚️",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py",
    "image_filters.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "required": true,
      "description": "输入图像对象 ID"
    },
    {
      "name": "brightness",
      "type": "float",
      "default": 1.0,
      "description": "亮度倍率 0~2（1 = 不变，>1 变亮，<1 变暗）"
    },
    {
      "name": "contrast",
      "type": "float",
      "default": 1.0,
      "description": "对比度倍率 0~2（1 = 不变，>1 增强）"
    },
    {
      "name": "gamma",
      "type": "float",
      "default": 1.0,
      "description": "伽马 0.1~3（1 = 不变；>1 变亮，<1 变暗，走 256 项 LUT）"
    },
    {
      "name": "sharpness",
      "type": "float",
      "default": 1.0,
      "description": "锐度倍率 0~3（1 = 不变，0 = 完全模糊）"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "BRIGHTNESS": "{{ Param.brightness }}",
    "CONTRAST": "{{ Param.contrast }}",
    "GAMMA": "{{ Param.gamma }}",
    "IMAGE": "{{ Param.image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "SHARPNESS": "{{ Param.sharpness }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.17.0"
}
