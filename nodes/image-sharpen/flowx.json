{
  "name": "image-sharpen",
  "displayName": "锐化",
  "description": "锐化（对标 ComfyUI Image Sharpen / WAS USM）：usm（UnsharpMask，radius/percent/threshold）或 simple（ImageEnhance 强度倍率）。纯节点侧 PIL。",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference",
    "image",
    "filter"
  ],
  "icon": "🔪",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "image_io.py",
    "image_filters.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "service_url_host",
      "type": "string",
      "description": "Studio 宿主机侧（画布）可达的服务地址（预览帧中转用），留空同 service_url",
      "required": false,
      "default": ""
    },
    {
      "name": "image",
      "type": "string",
      "required": true,
      "description": "输入图像对象 ID"
    },
    {
      "name": "mode",
      "type": "string",
      "default": "usm",
      "description": "锐化类型：usm（USM 锐化）/ simple（简单强度锐化）"
    },
    {
      "name": "radius",
      "type": "float",
      "default": 2.0,
      "description": "USM 半径 0~32（仅 mode=usm；越大作用范围越宽）"
    },
    {
      "name": "percent",
      "type": "float",
      "default": 150.0,
      "description": "强度：usm 下为百分比 0~300；simple 下为倍率百分比（200 = 2.0 倍）"
    },
    {
      "name": "threshold",
      "type": "float",
      "default": 3.0,
      "description": "USM 阈值 0~255（仅 mode=usm；低于阈值的差异不锐化，防噪点放大）"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "IMAGE": "{{ Param.image }}",
    "MODE": "{{ Param.mode }}",
    "PERCENT": "{{ Param.percent }}",
    "RADIUS": "{{ Param.radius }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}",
    "SERVICE_URL": "{{ Param.service_url }}",
    "SERVICE_URL_HOST": "{{ Param.service_url_host }}",
    "THRESHOLD": "{{ Param.threshold }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "处理后图像在推理服务的对象 ID"
    },
    {
      "name": "width",
      "type": "integer",
      "description": "结果宽度（像素）"
    },
    {
      "name": "height",
      "type": "integer",
      "description": "结果高度（像素）"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  },
  "image": "lerkobba/flowx-pixelforge-nodes:v1.19.6"
}
