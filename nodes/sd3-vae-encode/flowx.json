{
  "name": "sd3-vae-encode",
  "displayName": "SD3 VAE 编码",
  "description": "SD3.5 VAE 编码：图像 → 16ch latent（(latents-shift)*scaling），供 sd3-sampler 以 denoise<1 做图生图。自包含节点：算子 sd3.vae.encode 随包自注册",
  "version": "1.0.0",
  "author": "flowx-team",
  "tags": [
    "sd3",
    "mmdit",
    "inference"
  ],
  "icon": "📥",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py",
    "server_op.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.6.2",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "vae_ref",
      "type": "string",
      "description": "VAE 引用 ID（SD3.5 管道视图）",
      "required": true,
      "source": {
        "nodeRef": "checkpoint-loader",
        "output": "vae_ref",
        "description": "由 Checkpoint 加载节点（SD3.5 目录）的 vae_ref 提供"
      }
    },
    {
      "name": "image",
      "type": "string",
      "description": "输入图像引用（接 load-image 的输出）",
      "required": true,
      "source": {
        "nodeRef": "load-image",
        "output": "image",
        "description": "加载图像节点的 image 输出"
      }
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌",
      "required": false,
      "default": ""
    }
  ],
  "outputs": [
    {
      "name": "latent",
      "type": "string",
      "description": "16ch LATENT 对象引用，接 sd3-sampler（配 denoise<1）"
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "VAE_REF": "{{ Param.vae_ref }}",
    "IMAGE": "{{ Param.image }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "timeout": 660,
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 280,
    "height": 320,
    "collapsed": false,
    "apiVersion": 1
  },
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  }
}
