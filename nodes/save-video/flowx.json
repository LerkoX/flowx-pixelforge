{
  "name": "save-video",
  "displayName": "保存视频",
  "description": "从推理服务下载视频 mp4 保存到本地目录；画布组件经 Studio /api/v1/media/file 资源接口直读播放（不再内嵌 base64）。仅本地执行器运行：保存文件须落在 Studio 宿主机的媒体白名单目录（默认 ~/flowx-output），容器内保存对画布不可见。",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": [
    "video",
    "inference"
  ],
  "icon": "📼",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py"
  ],
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "video",
      "type": "string",
      "description": "推理服务端的 VIDEO 对象 ID",
      "required": true,
      "source": {
        "nodeRef": "video-gen",
        "output": "video",
        "description": "由视频生成节点输出提供"
      }
    },
    {
      "name": "filename_prefix",
      "type": "string",
      "description": "文件名前缀（自动追加时间戳与 .mp4 后缀），非法字符会被替换为下划线",
      "required": false,
      "default": "flowx-video"
    },
    {
      "name": "output_dir",
      "type": "string",
      "description": "本地保存目录（支持 ~ 展开），不存在时自动创建",
      "required": false,
      "default": "~/flowx-output"
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "VIDEO": "{{ Param.video }}",
    "FILENAME_PREFIX": "{{ Param.filename_prefix }}",
    "OUTPUT_DIR": "{{ Param.output_dir }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "file_path",
      "type": "string",
      "description": "保存后的本地 mp4 文件路径"
    },
    {
      "name": "size_bytes",
      "type": "integer",
      "description": "文件大小（字节）"
    }
  ],
  "extract": {
    "type": "codec-block",
    "maxOutputSize": 6291456
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 300,
    "height": 320,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 600,
  "executor": {
    "supportedTypes": [
      "local"
    ],
    "preferredType": "local"
  }
}
