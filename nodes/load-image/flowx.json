{
  "name": "load-image",
  "displayName": "加载图像",
  "description": "读取 FlowX 侧本地图片并上传到推理服务（对应 ComfyUI Load Image），输出图像对象 ID，供 VAE 编码（图生图）等下游节点使用",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": [
    "sd",
    "inference"
  ],
  "icon": "🖼️",
  "language": "python",
  "entry": "main.py",
  "files": [
    "flowx_client.py"
  ],
  "image": "lerkobba/flowx-pixelforge-nodes:v1.5.0",
  "parameters": [
    {
      "name": "service_url",
      "type": "string",
      "description": "推理服务地址，如 http://192.168.1.100:8100",
      "required": true,
      "source": {
        "nodeRef": "inference-ensure",
        "output": "service_url",
        "description": "推荐由健康检查节点输出提供"
      }
    },
    {
      "name": "image_path",
      "type": "string",
      "description": "FlowX 所在机器的本地图片路径（支持 ~ 展开），PNG/JPEG",
      "required": true
    },
    {
      "name": "service_token",
      "type": "string",
      "description": "服务端 INFERENCE_TOKEN 鉴权令牌，未启用鉴权时留空",
      "required": false,
      "default": ""
    }
  ],
  "env": {
    "SERVICE_URL": "{{ Param.service_url }}",
    "IMAGE_PATH": "{{ Param.image_path }}",
    "SERVICE_TOKEN": "{{ Param.service_token }}"
  },
  "outputs": [
    {
      "name": "image",
      "type": "string",
      "description": "上传后图像在推理服务的对象 ID"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "mock": {
    "enabled": true,
    "entry": "mock.py"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 300,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 300,
  "executor": {
    "supportedTypes": [
      "local",
      "docker"
    ],
    "preferredType": "docker",
    "bundled": true
  }
}